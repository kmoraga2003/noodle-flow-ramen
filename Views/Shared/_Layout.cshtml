<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Noodle Flow Ramen | Auténtico Ramen Artesanal</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Custom Ramen Theme CSS -->
    <link rel="stylesheet" href="~/css/ramen-theme.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-ramen fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="me-2 text-warning fs-3">🍜</span>
                    <span>Noodle Flow</span>&nbsp;Ramen
                </a>
                
                <button class="navbar-toggler border-secondary text-white" type="button" data-bs-toggle="collapse" data-bs-target="#ramenNavbar">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>

                <div class="collapse navbar-collapse" id="ramenNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")" asp-controller="Menu" asp-action="Index">
                                <i class="fa-solid fa-bowl-food me-1"></i> Menú de Ramen
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservation" ? "active" : "")" asp-controller="Reservation" asp-action="Index">
                                <i class="fa-solid fa-calendar-check me-1"></i> Reservas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">
                                <i class="fa-solid fa-location-dot me-1"></i> Contacto y Ubicación
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        <button type="button" class="btn btn-ramen-gold me-2 btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#cartModal">
                            <i class="fa-solid fa-cart-shopping me-1"></i> Pedido
                            <span class="cart-badge badge">0</span>
                        </button>
                        <a class="btn btn-ramen-primary btn-sm rounded-pill px-3" asp-controller="Reservation" asp-action="Index">
                            Reservar Mesa
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="padding-top: 72px;">
        @RenderBody()
    </main>

    <!-- Modal de Carrito / Simulación de Pedido -->
    <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-content-ramen">
                <div class="modal-header">
                    <h5 class="modal-title text-warning font-weight-bold" id="cartModalLabel">
                        <i class="fa-solid fa-basket-shopping me-2"></i> Tu Pedido de Ramen
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="cartModalItems">
                    <!-- Contenido dinámico renderizado por cart.js -->
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <div>
                        <span class="text-muted me-2">Total Estimado:</span>
                        <span class="fs-4 font-weight-bold text-warning" id="cartModalTotal">$0 CLP</span>
                    </div>
                    <div>
                        <button type="button" class="btn btn-ramen-outline me-2" onclick="RamenCart.clearCart()">Vaciar</button>
                        <button type="button" class="btn btn-ramen-gold" id="cartCheckoutBtn" disabled>
                            Confirmar Pedido <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer-ramen text-center text-md-start mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-warning font-weight-bold mb-3">
                        <span class="me-1">🍜</span> Noodle Flow Ramen
                    </h5>
                    <p class="small text-muted">
                        Pasión por la tradición japonesa. Caldos artesanales cocinados durante 18 horas y fideos frescos preparados cada mañana a mano.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white font-weight-bold mb-3"><i class="fa-regular fa-clock me-2 text-warning"></i> Horarios de Atención</h6>
                    <ul class="list-unstyled small text-muted">
                        <li>Lunes a Jueves: 12:30 - 22:30</li>
                        <li>Viernes y Sábados: 12:30 - 23:30</li>
                        <li>Domingos: 13:00 - 21:30</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-location-dot me-2 text-warning"></i> Encuéntranos</h6>
                    <p class="small text-muted mb-1">Av. Ramen Tradicional 108, Providencia</p>
                    <p class="small text-muted mb-1">Contacto: reservas@noodleflowramen.cl | +56 9 8765 4321</p>
                    <div class="mt-3">
                        <a href="#" class="text-warning me-3 fs-5"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-warning me-3 fs-5"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-warning fs-5"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25" />
            <div class="text-center small text-muted">
                &copy; @DateTime.Now.Year Noodle Flow Ramen - Todos los derechos reservados. Proyecto Demo ASP.NET Core MVC.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Cart Script -->
    <script src="~/js/cart.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
