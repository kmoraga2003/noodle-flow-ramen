@{
    ViewData["Title"] = "Contacto y Ubicación";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark font-weight-bold px-3 py-2 rounded-pill mb-2">VISÍTANOS</span>
        <h1 class="display-5 font-weight-bold text-white">Ubicación y Contacto</h1>
        <p class="text-muted mx-auto" style="max-width: 600px;">
            Te esperamos en nuestro local tradicional en Providencia. Ven a disfrutar del aroma del caldo recién hecho.
        </p>
    </div>

    <div class="row g-4 mb-5">
        <!-- Tarjeta de Horarios y Dirección -->
        <div class="col-lg-5">
            <div class="ramen-card p-4 p-md-5">
                <h4 class="text-warning font-weight-bold mb-4">
                    <i class="fa-solid fa-store me-2"></i> Información del Local
                </h4>

                <div class="mb-4">
                    <h6 class="text-white font-weight-bold"><i class="fa-solid fa-location-dot me-2 text-danger"></i> Dirección</h6>
                    <p class="text-muted small mb-0">Av. Ramen Tradicional 108, Providencia, Santiago</p>
                    <small class="text-warning opacity-75">A 3 minutos de Estación de Metro Pedro de Valdivia</small>
                </div>

                <div class="mb-4">
                    <h6 class="text-white font-weight-bold"><i class="fa-solid fa-clock me-2 text-warning"></i> Horario de Cocina</h6>
                    <ul class="list-unstyled text-muted small mb-0">
                        <li class="d-flex justify-content-between py-1 border-bottom border-secondary opacity-75">
                            <span>Lunes - Jueves</span>
                            <span class="text-white font-weight-bold">12:30 - 22:30</span>
                        </li>
                        <li class="d-flex justify-content-between py-1 border-bottom border-secondary opacity-75">
                            <span>Viernes - Sábado</span>
                            <span class="text-white font-weight-bold">12:30 - 23:30</span>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span>Domingo</span>
                            <span class="text-white font-weight-bold">13:00 - 21:30</span>
                        </li>
                    </ul>
                </div>

                <div class="mb-4">
                    <h6 class="text-white font-weight-bold"><i class="fa-solid fa-phone me-2 text-success"></i> Reservas y Consultas</h6>
                    <p class="text-muted small mb-1">Teléfono Directo: +56 9 8765 4321</p>
                    <p class="text-muted small mb-0">Email: contacto@noodleflowramen.cl</p>
                </div>

                <div class="d-grid mt-4">
                    <a asp-controller="Reservation" asp-action="Index" class="btn btn-ramen-gold">
                        <i class="fa-solid fa-calendar-check me-2"></i> Reservar Mesa Online
                    </a>
                </div>
            </div>
        </div>

        <!-- Mapa Interactivo Visual / Tarjeta de Mapa -->
        <div class="col-lg-7">
            <div class="ramen-card p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <h4 class="text-warning font-weight-bold mb-3">
                        <i class="fa-solid fa-map-location-dot me-2"></i> Mapa de Ubicación
                    </h4>
                    <p class="text-muted small mb-4">
                        Encuentra nuestro local fácilmente en el corazón gastronómico de la ciudad. Estacionamiento privado disponible para clientes.
                    </p>
                </div>

                <!-- Mapa estilizado interactivo SVG / Canvas Container -->
                <div class="position-relative rounded-4 overflow-hidden border border-secondary my-3" style="height: 320px; background: radial-gradient(circle at 50% 50%, #2b211a 0%, #17110d 100%);">
                    <div class="position-absolute top-50 start-50 translate-middle text-center p-4">
                        <div class="fs-1 text-danger animate-bounce mb-2">📍</div>
                        <h5 class="text-white font-weight-bold mb-1">Noodle Flow Ramen</h5>
                        <p class="text-warning small mb-3">Av. Ramen Tradicional 108, Providencia</p>
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill font-weight-bold">
                            <i class="fa-solid fa-utensils me-1"></i> Abierto Ahora
                        </span>
                    </div>

                    <!-- Cuadrícula decorativa de calles estilo mapa oscuro -->
                    <svg width="100%" height="100%" style="opacity: 0.15; position: absolute; top:0; left:0;">
                        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#f39c12" stroke-width="1" />
                        </pattern>
                        <rect width="100%" height="100%" fill="url(#grid)" />
                        <line x1="0" y1="50%" x2="100%" y2="50%" stroke="#d9381e" stroke-width="4" />
                        <line x1="50%" y1="0" x2="50%" y2="100%" stroke="#d9381e" stroke-width="4" />
                    </svg>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="small text-muted"><i class="fa-solid fa-square-parking me-1 text-warning"></i> Estacionamiento Gratuito (1 hr)</span>
                    <a href="https://maps.google.com" target="_blank" class="btn btn-ramen-outline btn-sm">
                        Abrir en Google Maps <i class="fa-solid fa-up-right-from-square ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
